---
/**
 * PostLayout - Layout for garden posts/notes
 *
 * Displays:
 * - Post title and metadata
 * - Growth status indicator
 * - Tags
 * - Table of contents (optional)
 * - Content
 * - Local graph
 * - Backlinks (linked mentions)
 */

import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GrowthIndicator from '../components/GrowthIndicator.astro';
import Tags from '../components/Tags.astro';
import LocalGraph from '../components/LocalGraph.astro';
import LinkedMentions from '../components/LinkedMentions.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Giscus from '../components/Giscus.astro';
import LinkPreview from '../components/LinkPreview.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import CodeCopyButton from '../components/CodeCopyButton.astro';
import ConfidenceRating from '../components/ConfidenceRating.astro';
import ImportanceRating from '../components/ImportanceRating.astro';
import LectureFigure from '../components/roadmap/LectureFigure.astro';
import { siteConfig } from '../config';
import { getCollection } from 'astro:content';
import studyTracks from '../study-tracks.json';
import type { Post, GrowthStatus } from '../types';
import type { GrowthMetrics } from '../utils/growth';

export interface Props {
  post: Post;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  effectiveGrowth?: GrowthStatus;
  growthMetrics?: GrowthMetrics;
}

const { post, headings = [], effectiveGrowth, growthMetrics } = Astro.props;
const { title, description, growth, planted, lastTended, tags, image, imageAlt, confidence, importance } = post.data;

// Study site: curriculum fields from scripts/sync-study.mjs
const { lectureNumber, status, trackName, track, time, prereqs = [], prereqsText, checkpoint, exercise, exerciseName, videos = [], prev, next, source } = post.data;
const isLecture = Boolean(lectureNumber);
const lectureTitles = new Map((await getCollection('posts')).map((p) => [p.id, p.data.title]));
const linkTo = (slug: string) => ({ href: `/posts/${slug}/`, title: lectureTitles.get(slug) || slug });
const prevLecture = prev ? linkTo(prev) : null;
const nextLecture = next ? linkTo(next) : null;
// Render the small amount of markdown the checkpoint text uses: `code`, [text](url), **bold**.
const inlineMd = (s: string) => s
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
  .replace(/`([^`]+)`/g, '<code>$1</code>')
  .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
  .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>');
const statusNote: Record<string, string> = {
  unreviewed: 'Unreviewed: no one has checked this end to end. Treat the math, code, and citations as unverified.',
  reviewed: 'Reviewed: a person has read this end to end and stands behind it.',
  'hand-written': 'Hand-written: a person wrote this.',
};
// Use effective growth if provided, otherwise fall back to manual growth
const displayGrowth = effectiveGrowth || growth;

// Format dates
const plantedDate = planted.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const tendedDate = lastTended?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Calculate reading time (rough estimate)
const content = post.body || '';
const words = content.split(/\s+/).length;
const readingTime = Math.ceil(words / 200);

// Build canonical URL
const canonicalUrl = new URL(`/posts/${post.id}`, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;

// JSON-LD structured data for SEO
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description || "",
  "author": {
    "@type": "Person",
    "name": siteConfig.gardener,
    "url": Astro.site
  },
  "datePublished": planted.toISOString(),
  "dateModified": lastTended?.toISOString() || planted.toISOString(),
  "url": canonicalUrl.toString(),
  "wordCount": words,
  "timeRequired": `PT${readingTime}M`,
  ...(ogImage && { "image": ogImage.toString() }),
  ...(tags && tags.length > 0 && { "keywords": tags.join(", ") }),
  "publisher": {
    "@type": "Person",
    "name": siteConfig.gardener,
    "url": Astro.site
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl.toString()
  }
};

// Study site: roadmap design bits
const allPosts = await getCollection('posts');
const totalLectures = allPosts.filter((p) => p.data.lectureNumber).length;
const trackColor = studyTracks.find((t) => t.id === track)?.color ?? 'var(--yellow)';
const displayTitle = isLecture ? title.replace(/^Lecture \d\d:\s*/, '') : title;
---

<BaseLayout title={title} description={description} image={image}>
  <!-- JSON-LD structured data -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Header slot="header" />

  <div class="bk">
    <header class="bk-page bk-head">
      {isLecture ? (
        <p class="bk-label">
          <span class="bk-swatch" style={`background: ${trackColor}`}></span>lecture {lectureNumber} of {totalLectures} · <a href={`/tracks/${track}/`} style="color: inherit">{trackName}</a>{time && ` · ${time}`}
        </p>
      ) : (
        tags && tags.length > 0 && <p class="bk-label">{tags.join(' · ')}</p>
      )}
      <h1>{displayTitle}</h1>
      {status && (
        <p class="bk-status">
          {status === 'unreviewed'
            ? <><span class="bk-stamp">unreviewed draft</span>No one has checked this end to end. Treat the math, code, and citations as unverified.</>
            : <><span class="bk-stamp ok">{status}</span>{statusNote[status] || ''}</>}
          {source && <> <a href={source}>Source on GitHub</a>.</>}
        </p>
      )}
      <p class="bk-meta" style="margin: 0">{tendedDate && <>Updated {tendedDate}. </>}About {readingTime} minutes to read.</p>
    </header>

    <div class="bk-article">
      <article>
        {isLecture && (prereqs.length > 0 || checkpoint || exercise || videos.length > 0) && (
          <section class="bk-box bk-facts-box" aria-label="Before you start">
            <dl>
              <div>
                <dt>read first</dt>
                <dd>
                  {prereqs.length > 0
                    ? prereqs.map((slug, i) => <>{i > 0 && ', '}<a href={linkTo(slug).href}>{linkTo(slug).title}</a></>)
                    : 'Nothing: this is a starting point.'}
                  {prereqsText && /[a-z]/i.test(prereqsText.replace(/none/i, '')) && <span style="color: var(--muted)"> ({prereqsText})</span>}
                </dd>
              </div>
              {checkpoint && (
                <div>
                  <dt>checkpoint, for when you finish</dt>
                  <dd set:html={inlineMd(checkpoint)} />
                </div>
              )}
              {exercise && (
                <div>
                  <dt>exercise</dt>
                  <dd><a href={exercise}>{exerciseName}</a>, with a starter file, pytest tests, graduated hints, and a reference solution.</dd>
                </div>
              )}
              {videos.length > 0 && (
                <div>
                  <dt>on video</dt>
                  <dd>
                    <div class="watch">
                      {videos.map((v) => (
                        <a href={`https://www.youtube.com/watch?v=${v.id}`}>
                          <img src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`} alt="" loading="lazy" width="320" height="180" />
                          {v.title}
                        </a>
                      ))}
                    </div>
                  </dd>
                </div>
              )}
            </dl>
          </section>
        )}

        {isLecture && <LectureFigure lecture={lectureNumber} />}

        {image && (
          <figure style="margin: 0 0 2rem">
            <img src={image} alt={imageAlt || title} style="width: 100%" />
          </figure>
        )}

        <div class="prose-mycelium">
          <slot />
        </div>
        <CodeCopyButton />

        {isLecture && (prevLecture || nextLecture) && (
          <nav class="bk-prevnext" aria-label="Curriculum order">
            {prevLecture && <a href={prevLecture.href}><small>previous</small><b>{prevLecture.title}</b></a>}
            {nextLecture
              ? <a class="next" href={nextLecture.href}><small>next</small><b>{nextLecture.title}</b></a>
              : <a class="next" href="/curriculum/"><small>that was the last one</small><b>Back to the curriculum</b></a>}
          </nav>
        )}

        <LinkedMentions currentSlug={post.id} />
        <Giscus />
      </article>

      <aside>
        <div class="sticky-box">
          {siteConfig.features.tableOfContents && headings.length > 0 && <TableOfContents headings={headings} />}
        </div>
      </aside>
    </div>
  </div>

  <Footer slot="footer" />

  {siteConfig.features.linkPreviews && <LinkPreview />}
  {siteConfig.features.imageLightbox && <ImageLightbox />}
</BaseLayout>

<!-- Twitter Widget Script for embedded tweets -->
<script>
  // Load Twitter widget script if there are tweet embeds
  document.addEventListener('DOMContentLoaded', () => {
    const tweetEmbeds = document.querySelectorAll('.twitter-embed');
    if (tweetEmbeds.length > 0) {
      const script = document.createElement('script');
      script.src = 'https://platform.twitter.com/widgets.js';
      script.async = true;
      script.charset = 'utf-8';
      document.body.appendChild(script);
    }
  });
</script>

<!-- Mermaid diagram rendering -->
<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const mermaidContainers = document.querySelectorAll('.mermaid');
    if (mermaidContainers.length > 0) {
      // @ts-ignore - Dynamic import
      const mermaid = await import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs');

      // Configure mermaid
      mermaid.default.initialize({
        startOnLoad: false,
        theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default',
        securityLevel: 'loose',
        fontFamily: 'inherit',
      });

      // Render all mermaid diagrams
      mermaid.default.run({
        nodes: mermaidContainers,
      });

      // Re-render on theme change
      window.addEventListener('themechange', (e: CustomEvent) => {
        mermaid.default.initialize({
          startOnLoad: false,
          theme: e.detail.dark ? 'dark' : 'default',
          securityLevel: 'loose',
          fontFamily: 'inherit',
        });

        // Need to reset and re-render
        mermaidContainers.forEach((container) => {
          const svg = container.querySelector('svg');
          if (svg) {
            const original = container.getAttribute('data-original');
            if (original) {
              container.innerHTML = original;
            }
          }
        });

        mermaid.default.run({
          nodes: mermaidContainers,
        });
      });

      // Store original content for re-rendering
      mermaidContainers.forEach((container) => {
        container.setAttribute('data-original', container.innerHTML);
      });
    }
  });
</script>

<!-- Image gallery lightbox -->
<script>
  function initGalleries() {
    const galleries = document.querySelectorAll('[data-gallery]');

    galleries.forEach((gallery) => {
      const thumbnails = gallery.querySelectorAll('.gallery-thumbnail');
      const lightbox = gallery.querySelector('[data-lightbox]') as HTMLElement;
      if (!lightbox) return;

      const lightboxImage = gallery.querySelector('[data-lightbox-image]') as HTMLImageElement;
      const lightboxCaption = gallery.querySelector('[data-lightbox-caption]') as HTMLElement;
      const lightboxCounter = gallery.querySelector('[data-lightbox-counter]') as HTMLElement;
      const closeBtn = gallery.querySelector('[data-lightbox-close]');
      const prevBtn = gallery.querySelector('[data-lightbox-prev]');
      const nextBtn = gallery.querySelector('[data-lightbox-next]');

      let currentIndex = 0;
      const totalImages = thumbnails.length;

      function showImage(index: number) {
        currentIndex = (index + totalImages) % totalImages;
        const thumb = thumbnails[currentIndex] as HTMLElement;

        lightboxImage.src = thumb.dataset.src || '';
        lightboxImage.alt = thumb.dataset.alt || '';

        const caption = thumb.dataset.caption;
        if (caption) {
          lightboxCaption.textContent = caption;
          lightboxCaption.classList.remove('hidden');
        } else {
          lightboxCaption.classList.add('hidden');
        }

        if (lightboxCounter) {
          lightboxCounter.textContent = `${currentIndex + 1} / ${totalImages}`;
        }
      }

      function openLightbox(index: number) {
        showImage(index);
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        document.body.style.overflow = '';
      }

      thumbnails.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const index = parseInt((thumb as HTMLElement).dataset.index || '0');
          openLightbox(index);
        });
      });

      closeBtn?.addEventListener('click', closeLightbox);

      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        showImage(currentIndex - 1);
      });

      nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        showImage(currentIndex + 1);
      });

      const handleKeydown = (e: KeyboardEvent) => {
        if (!lightbox.classList.contains('flex')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
        if (e.key === 'ArrowRight') showImage(currentIndex + 1);
      };

      document.addEventListener('keydown', handleKeydown);
    });
  }

  document.addEventListener('DOMContentLoaded', initGalleries);
  document.addEventListener('astro:page-load', initGalleries);
</script>

<!-- External links open in new tab -->
<script>
  function initExternalLinks() {
    const proseLinks = document.querySelectorAll('.prose-mycelium a[href^="http"]');
    proseLinks.forEach(link => {
      const href = link.getAttribute('href');
      // Skip localhost links
      if (href?.includes('localhost')) return;
      // Add target and rel attributes
      link.setAttribute('target', '_blank');
      link.setAttribute('rel', 'noopener noreferrer');
    });
  }
  document.addEventListener('DOMContentLoaded', initExternalLinks);
  document.addEventListener('astro:page-load', initExternalLinks);
</script>
