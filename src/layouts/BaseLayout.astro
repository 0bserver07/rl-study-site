---
/**
 * BaseLayout - Root layout for all pages
 *
 * Handles:
 * - HTML document structure
 * - SEO meta tags
 * - Dark mode initialization
 * - Global styles
 * - Command palette
 */

import { siteConfig } from '../config';
import CommandPalette from '../components/CommandPalette.astro';
import GlobalGraph from '../components/GlobalGraph.astro';
import '../styles/global.css';
// Study site: typeset like a book. Alegreya for text and headings, Alegreya SC
// for small-caps labels, Kalam for the few handwritten margin notes; code uses
// the system monospace.
import '@fontsource/alegreya/400.css';
import '@fontsource/alegreya/400-italic.css';
import '@fontsource/alegreya/500.css';
import '@fontsource/alegreya/700.css';
import '@fontsource/alegreya/700-italic.css';
import '@fontsource/alegreya/800.css';
import '@fontsource/alegreya-sc/500.css';
import '@fontsource/alegreya-sc/700.css';
import '@fontsource/kalam/400.css';
import '../styles/roadmap.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Absolute URL of this page's own share card (og:image, twitter:image). */
  shareImage?: string;
  noIndex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  image,
  shareImage,
  noIndex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.name;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
// Study site: the page's own share card if it has one (each lecture does),
// else the post image if provided, else the default card.
const ogImage = shareImage
  ? new URL(shareImage, Astro.site)
  : image
    ? new URL(image, Astro.site)
    : new URL('/og-default.png', Astro.site);
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Study site: dark or light, decided before anything is painted and before any
         stylesheet: a choice saved by the header's toggle wins, otherwise the OS setting.
         src/scripts/theme.ts handles every change after this. -->
    <script is:inline>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        var dark = saved === 'dark' || (saved !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- KaTeX CSS for math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous" />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.gardener} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- RSS Feed -->
    {siteConfig.features.rss && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={siteConfig.name}
        href="/feed.xml"
      />
    )}

    <!-- Robots -->
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    {ogImage && <meta property="twitter:image" content={ogImage} />}

    <!-- Slot for page-specific head content (JSON-LD, etc.) -->
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <slot name="header" />

    <main class="grow">
      <slot />
    </main>

    <slot name="footer" />

    <!-- Command Palette -->
    <CommandPalette />

    <!-- Global Graph -->
    {siteConfig.features.graphView && <GlobalGraph />}

    <!-- Theme toggle script -->
    <script>
      // Study site: every [data-theme-toggle] button (the header's "dark"/"light") and the
      // command palette's quick action go through src/scripts/theme.ts, which saves the
      // choice and fires `themechange` on window for figures that redraw.
      import { toggleTheme, watchTheme } from '../scripts/theme';

      function initThemeToggle() {
        document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((button) => {
          if (button.dataset.themeReady) return;
          button.dataset.themeReady = '1';
          button.addEventListener('click', toggleTheme);
        });
      }

      watchTheme();
      // Initialize on load and after page transitions
      document.addEventListener('DOMContentLoaded', initThemeToggle);
      document.addEventListener('astro:page-load', initThemeToggle);
    </script>
  </body>
</html>
