---
/**
 * Homepage (study site): a hub, not an article.
 *
 * Opens with a Q-learning agent learning a gridworld in the browser, then
 * walks one topic through the four steps (read, watch, build, check), lists
 * the nine exercises, the eight tracks (each has its own page), the landscape
 * map, the rules for studying, and an index of everything on the site.
 * Onboarding (prerequisites, planner, week one, help) lives on /start/.
 * Data: src/generated/study.json (written by scripts/sync-study.mjs).
 */

import fs from 'node:fs';
import path from 'node:path';
import { Code } from 'astro:components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LandscapeMap from '../components/LandscapeMap.astro';
import TrackMap from '../components/roadmap/TrackMap.astro';
import GridLearner from '../components/roadmap/GridLearner.astro';
import Signup from '../components/roadmap/Signup.astro';
import study from '../generated/study.json';
import { siteConfig } from '../config';

const lectures = study.lectures;
const byNum = new Map(lectures.map((l) => [l.num, l]));
const colorOf = (num: string) => study.tracks.find((t) => t.id === byNum.get(num)?.track)?.color ?? 'var(--ink)';
const totalHours = Math.round(study.totalHours);
const totalTests = study.exercises.reduce((s, e) => s + (e.tests ?? 0), 0);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'];
const say = (n: number) => WORDS[n] ?? String(n);

// The worked example: lecture 03 and its exercise, the same algorithm as Figure 1.
const l01 = byNum.get('01')!;
const l03 = byNum.get('03')!;
const ex03 = study.exercises.find((e) => e.name === '03-q-learning')!;
const silverFor03 = l03.videos.filter((v) => v.title.startsWith('David Silver, '));
const qUpdate = (() => {
  try {
    const src = fs.readFileSync(path.join(process.cwd(), 'study', 'exercises', '03-q-learning', 'starter.py'), 'utf8');
    return src.match(/def q_update[\s\S]*?raise NotImplementedError\("q_update"\)/)?.[0] ?? '';
  } catch {
    return '';
  }
})();

// The readme's landscape paragraphs use a little markdown: *em*, `code`, [text](url)
const inlineMd = (s: string) => s
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
  .replace(/`([^`]+)`/g, '<code>$1</code>')
  .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>')
  .replace(/\*([^*]+)\*/g, '<em>$1</em>');

const rules = [
  ['Write the code yourself.', 'Every exercise has a <code>starter.py</code> with TODOs and tests that only pass when the code is right. Fill it in before you look at anything else.'],
  ['Take one hint at a time.', '<code>HINTS.md</code> goes from a nudge to nearly the answer. Read the next hint only when you are stuck on the current one.'],
  ['Do the checkpoint with the book closed.', 'Every lecture ends with something to derive, write, or explain. Close the page first.'],
  ['Passing is not understanding.', 'An exercise is done when the tests pass and you can say why your implementation works.'],
  ['Debug small.', 'Use CartPole or a gridworld, where a run takes minutes. Broken RL code often runs without errors and just does not learn.'],
  ['Come back a week later.', 'Redo an old checkpoint after a gap. Testing yourself after a delay does more for memory than rereading (Roediger and Karpicke, 2006).'],
  ['Pair text with video.', 'Eleven lectures link the matching episode of David Silver\'s course or Berkeley\'s CS 285.'],
  ['Read drafts like drafts.', 'Every lecture here is unreviewed. When a formula matters, check it against the cited paper first.'],
];

const everything = [
  { label: 'Lectures', href: '/library/#lectures', count: `${lectures.length}` },
  { label: 'Exercises with tests', href: '/exercises/', count: `${study.exercises.length}, with ${totalTests} tests` },
  { label: 'Homework sets', href: '/homework/', count: `${study.library.homework}` },
  { label: 'Cheat sheets', href: '/cheat-sheets/', count: `${study.library.cheatSheets}` },
  { label: 'Algorithm diagrams', href: '/diagrams/', count: '' },
  { label: 'Reading lists', href: '/reading/', count: `${study.library.readingLists} topics` },
  { label: 'Notes from 2017', href: '/notes/', count: `${study.library.notes2017}` },
  { label: 'Video courses', href: '/watch/', count: `${study.videoCourses.length}` },
  { label: 'The curriculum, in order', href: '/curriculum/', count: `about ${totalHours} hours` },
  { label: 'Changelog of the study repo', href: '/changelog/', count: '' },
  { label: 'Releases of this site', href: '/releases/', count: `v${study.version}` },
  { label: 'Working with an AI tutor', href: '/agents/', count: '' },
];
---

<BaseLayout description="Watch a Q-learning agent learn in your browser, then build one. 34 lectures in eight tracks, from MDPs to training language models, with tested exercises and a checkpoint for every lecture.">
  <Header slot="header" />

  <div class="bk">
    <!-- the demo, and what it is -->
    <section class="bk-wide bk-hero">
      <div>
        <p class="bk-label">study reinforcement learning</p>
        <h1>Watch an agent learn, then <span class="bk-hl">build one</span>.</h1>
        <p class="bk-byline">by <a href="#history">{siteConfig.gardener}</a> · <span>started 31 December 2016</span></p>
        <p class="bk-dek">
          The red dot starts out knowing nothing about this grid. Press Run and it wanders, falls into the pits, and now and then finds the +1.
          Every step updates its estimate of how much each move is worth. By fifty episodes it heads straight for the goal.
        </p>
        <p>
          That's Q-learning. <a href={`/posts/${l03.slug}/`}>Lecture 03</a> explains it, and in <a href={ex03.url}>exercise 03</a> you write it yourself.
          From there the guide goes all the way to how language models are trained with RL: {lectures.length} lectures in {say(study.tracks.length)} tracks, {say(study.exercises.length)} exercises with tests, and a checkpoint at the end of every lecture.
        </p>
        <p class="bk-go">
          <a class="first" href={`/posts/${l01.slug}/`}>Start with lecture 01</a>
          <a href="/start/">Before you start</a>
          <a href="/library/">Browse everything</a>
        </p>
      </div>
      <div class="bk-hero-demo">
        <span class="bk-note" aria-hidden="true">live, not a recording</span>
        <GridLearner caption="<b>Figure 1.</b> Q-learning on a small grid, running in your browser. The shading is how much the agent expects to collect from each square, green for good and red for bad, and the arrows are its best move so far. The line underneath is the return of each episode. Run shows every step; Train 50 episodes skips ahead." />
        <Signup />
      </div>
    </section>

    <!-- 1 -->
    <section class="bk-wide bk-sec" id="how">
      <div class="bk-col">
      <h2><span class="bk-secnum">1</span>One topic, start to finish</h2>
      <p>
        Every lecture is studied the same way: read it, watch it, build it, then check yourself with the page closed.
        Here are the four steps for the Q-learning in Figure 1.
      </p>
      <ol class="bk-steps">
        <li>
          <span class="n" aria-hidden="true">1</span>
          <div>
            <h3>Read</h3>
            <p><a href={`/posts/${l03.slug}/`}>Lecture 03</a> starts from value functions, builds the update one term at a time, shows that it's the Bellman equation rewritten as an update, and then scales it up to DQN.</p>
            <p class="bk-formula">Q(s, a) ← Q(s, a) + α [ r + γ max<sub>a′</sub> Q(s′, a′) − Q(s, a) ]</p>
          </div>
        </li>
        <li>
          <span class="n" aria-hidden="true">2</span>
          <div>
            <h3>Watch</h3>
            <p>
              The lecture page links the parts of David Silver's course that cover the same ground: {silverFor03.map((v, i) => <>{i > 0 && (i === silverFor03.length - 1 ? ', and ' : ', ')}<a href={`https://www.youtube.com/watch?v=${v.id}`}>{v.title.replace(/^David Silver, /, '')}</a></>)}.
              Watch them after reading, or before if you like to see it first.
            </p>
          </div>
        </li>
        <li>
          <span class="n" aria-hidden="true">3</span>
          <div>
            <h3>Build</h3>
            <p>Open <a href={ex03.url}>exercise 03</a>. You fill in three TODOs in <code>starter.py</code>, and this is one of them:</p>
            {qUpdate && <Code code={qUpdate} lang="python" theme="github-light" />}
            <p>
              Then run <code>pytest exercises/03-q-learning/</code>. The {say(ex03.tests)} tests pass when the code is right.
              Stuck? The hints go from a nudge to nearly the answer, and you take them one at a time.
            </p>
          </div>
        </li>
        <li>
          <span class="n" aria-hidden="true">4</span>
          <div>
            <h3>Check</h3>
            <p>Close the page and answer the lecture's checkpoint:</p>
            <blockquote class="bk-checkpoint">{l03.checkpoint}</blockquote>
            <p>Then answer it again a week later, without looking.</p>
          </div>
        </li>
      </ol>
      </div>
    </section>

    <!-- 2 -->
    <section class="bk-wide bk-sec" id="build">
      <div class="bk-col">
        <h2><span class="bk-secnum">2</span>Nine things you'll build</h2>
        <p>
          Each exercise is a starter file with TODOs, tests that pass only when the code is right, graduated hints, and a reference solution.
          All {say(study.exercises.length)} run on a laptop CPU, from value iteration on a gridworld to GRPO on a toy task with verifiable answers.
        </p>
      </div>
      <ol class="bk-builds">
        {study.exercises.map((e) => (
          <li style={`--c: ${colorOf(e.num)}`}>
            <a href={e.url}>{e.name}</a>
            <span class="what">{cap(e.what)}.</span>
            <span class="meta">{e.tests} tests · with lecture {e.num}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- 3 -->
    <section class="bk-wide bk-sec" id="tracks">
      <div class="bk-col">
        <h2><span class="bk-secnum">3</span>Eight tracks</h2>
        <p>
          Every track builds on Foundations. After that the tracks split by where the reward comes from, and you can take them in the order you need.
          Each track has its own page, with its lectures in order and the checkpoint for each.
        </p>
      </div>
      <figure style="margin-top: 1rem">
        <span class="bk-note bk-figure-note" style="left: 1%; top: 3.6rem">start here, then pick a track ↓</span>
        <TrackMap />
        <figcaption>
          <b>Figure 2.</b> The eight tracks. A solid arrow means a track's first lecture needs the track it comes from; a dashed one marks a single lecture that builds on another track.
          Click a track to open it.
        </figcaption>
      </figure>
      <ol class="bk-tracklist">
        {study.tracks.map((t, i) => (
          <li style={`--c: ${t.color}`}>
            <span class="no" aria-hidden="true">{i + 1}</span>
            <div>
              <a href={`/tracks/${t.id}/`}>{t.name}</a>
              <p>{t.blurb}</p>
              <p class="meta">{t.lectures.length} lectures, about {Math.round(t.hours)} hours{t.exerciseCount ? `, ${t.exerciseCount} ${t.exerciseCount === 1 ? 'exercise' : 'exercises'}` : ''}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- 4 -->
    <section class="bk-wide bk-sec" id="landscape">
      <div class="bk-col">
        <h2><span class="bk-secnum">4</span>One MDP, six families</h2>
        {study.landscape.map((p) => <p set:html={inlineMd(p)} />)}
      </div>
      <div style="margin-top: 1.5rem">
        <LandscapeMap />
      </div>
    </section>

    <!-- 5 -->
    <section class="bk-wide bk-sec" id="method">
      <div class="bk-col">
        <h2><span class="bk-secnum">5</span>Eight rules for studying RL</h2>
        <p>Reading about RL and getting a policy to learn are different skills. The lectures cover the first. The exercises and checkpoints cover the second, if you use them like this.</p>
      </div>
      <ol class="bk-rules" style="max-width: 50rem; margin-top: 1rem">
        {rules.map(([lead, text]) => <li><strong>{lead}</strong> <span set:html={text} /></li>)}
      </ol>
    </section>

    <!-- 6 -->
    <nav class="bk-wide bk-sec bk-toc" id="everything" aria-label="Everything on this site">
      <div class="bk-col">
      <h2><span class="bk-secnum">6</span>Everything here</h2>
      <p>The <a href="/library/">Library</a> lists every page on one page. Search with <kbd>Ctrl K</kbd>, or open the graph to see how the pages link to each other.</p>
      <ol>
        {everything.map((e) => (
          <li>
            <a href={e.href}>{e.label}</a>
            <span class="lead"></span>
            <span class="pg">{e.count}</span>
          </li>
        ))}
      </ol>
      </div>
    </nav>

    <!-- 7 -->
    <section class="bk-wide bk-sec" id="history">
      <div class="bk-col">
        <h2><span class="bk-secnum">7</span>How this started</h2>
        <p class="bk-lead">
          <span class="bk-hl">I'm {siteConfig.gardener}.</span> I started this repo on 31 December 2016 as a list of the talks and courses I was learning reinforcement learning from. It grew into the notes, lectures, and exercises on this site.
        </p>
      </div>
      <ol class="bk-history">
        <li>
          <span class="yr">2016</span>
          <p><b>The first list.</b> Joelle Pineau's and Pieter Abbeel's talks, Sutton and Barto's book, David Silver's course, and Berkeley's CS 294. It is still on the <a href="/watch/">Watch</a> page.</p>
        </li>
        <li>
          <span class="yr">2017</span>
          <p><b>A car that drives itself in GTA San Andreas.</b> That was my way into RL. It became <a href="https://github.com/0bserver07/Nvidia-Autopilot-Keras">Nvidia-Autopilot-Keras</a>, a Keras version of NVIDIA's end-to-end self-driving model.</p>
        </li>
        <li>
          <span class="yr">2017</span>
          <p><b>Berkeley's CS 294.</b> Deep Reinforcement Learning, taught by Sergey Levine, John Schulman, and Chelsea Finn. <a href="/notes/cs294-2017/">My notes from it</a> are kept as I wrote them.</p>
        </li>
        <li>
          <span class="yr word">later</span>
          <p>Program synthesis, then NLP with RL, then language models.</p>
        </li>
        <li>
          <span class="yr">2025</span>
          <p><b>The lectures.</b> {lectures.length} lectures, exercises with tests, and cheat sheets, drafted with AI coding assistants and then edited. Each lecture stays marked unreviewed until someone has read it end to end and checked it.</p>
        </li>
        <li>
          <span class="yr">2026</span>
          <p><b>This site.</b> The lectures, the exercises, the 2017 notes, and the first list, in one place.</p>
        </li>
      </ol>
      <p class="bk-col" style="margin-top: 1.2rem"><a href="/about/">The full story, and whose teaching this builds on</a>.</p>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
