---
/**
 * RewardModelBT: a Bradley-Terry reward model learned from pairwise labels.
 * One prompt, five answers (A to E), each with a hidden quality q. A simulated
 * labeler is shown two different answers, picked at random, and prefers i over j
 * with probability
 *   P(i preferred over j) = sigma(q_i - q_j)
 * which is the Bradley-Terry model. Exercise 09-reward-model labels its pairs the
 * same way, with sigma(beta * (r*(a) - r*(b))) and beta = 4; q here plays the part
 * of beta * r*, so the learned rewards land on the same scale as q.
 * The reward model is the simplest one there is: a table with one number r_i per
 * answer. Each click retrains it from zero on every label so far: 200 steps of
 * gradient descent, learning rate 1, on the mean of -log sigma(r_chosen - r_rejected).
 * Rewards are only defined up to a constant, so the bars (learned) and the ticks
 * (true) are both centred to mean 0. Spearman uses average ranks for ties.
 * The exercise trains a small MLP on 4-dim feature vectors instead of a table.
 */
interface Props { caption?: string }
const { caption } = Astro.props;

const NAMES = ['A', 'B', 'C', 'D', 'E'];
const Q = [1.5, 0.75, 0, -0.75, -1.5]; // hidden quality of each answer
const LIM = 3; // the axis runs from -3 to 3; longer bars end in an arrow
const W = 360, X0 = 72, X1 = 300, ROW = 34, TOP = 4;
const XC = (X0 + X1) / 2, UNIT = (X1 - X0) / (2 * LIM);
const BOTTOM = TOP + NAMES.length * ROW;
const H = BOTTOM + 22;
const qMean = Q.reduce((a, b) => a + b, 0) / Q.length;
const qc = Q.map((v) => v - qMean);
const GRID = Array.from({ length: 2 * LIM + 1 }, (_, k) => k - LIM);
const geom = { x0: X0, x1: X1, lim: LIM, row: ROW, top: TOP };
---

<figure class="rm-bt" data-rmbt data-q={JSON.stringify(Q)} data-geom={JSON.stringify(geom)}>
  <svg viewBox={`-8 -6 ${W + 16} ${H + 8}`} role="img" aria-label="Five answers to one prompt, A to E. For each answer, a bar shows the reward the model has learned and a tick shows the answer's true quality, both shifted to average zero." data-chart>
    {GRID.map((v) => (
      <>
        <line x1={XC + v * UNIT} x2={XC + v * UNIT} y1={TOP} y2={BOTTOM} class:list={['grid', { zero: v === 0 }]} />
        <text x={XC + v * UNIT} y={H - 6} text-anchor="middle" class="axis">{v < 0 ? `−${-v}` : String(v)}</text>
      </>
    ))}
    {NAMES.map((name, i) => {
      const cy = TOP + i * ROW + ROW / 2;
      return (
        <g data-row={i}>
          <text x="0" y={cy + 4.5} class="name">Answer {name}</text>
          <rect class="bar" x={XC} width="0" y={cy - 8} height="16" data-bar />
          <path class="bar more" d="" data-more />
          <line class="tick" x1={XC + qc[i] * UNIT} x2={XC + qc[i] * UNIT} y1={cy - 12} y2={cy + 12} />
          <text x={W - 1} y={cy + 4.5} text-anchor="end" class="val" data-val>0.00</text>
        </g>
      );
    })}
  </svg>
  <p class="rm-key">
    <span><svg viewBox="0 0 30 14" aria-hidden="true"><rect x="0" y="3" width="14" height="8" class="bar" /><rect x="16" y="3" width="14" height="8" class="bar neg" /></svg> learned reward</span>
    <span><svg viewBox="0 0 6 14" aria-hidden="true"><line x1="3" x2="3" y1="0" y2="14" class="tick" /></svg> true quality</span>
    <span>both shifted to average 0</span>
  </p>

  <div class="rm-controls">
    <button type="button" data-add="10">Label 10 pairs</button>
    <button type="button" data-add="100">Label 100 pairs</button>
    <button type="button" data-reset>Reset</button>
  </div>

  <div class="rm-stats" aria-live="polite">
    <span>labels <b data-n>0</b></span>
    <span>loss <b data-loss>none yet</b></span>
    <span>loss of the true qualities <b data-qloss>none yet</b></span>
    <span>ranking right <b data-rank>none yet</b></span>
    <span>Spearman <b data-rho>none yet</b></span>
  </div>

  {caption && <figcaption set:html={caption} />}
</figure>

<style>
  .rm-bt { margin: 0; }
  .rm-bt svg[data-chart] { width: 100%; height: auto; display: block; border: 1.2px solid var(--ink); background: var(--box); }
  .rm-bt .grid { stroke: var(--rule); stroke-width: 1; }
  .rm-bt .grid.zero { stroke: var(--muted); }
  .rm-bt .axis { font-family: var(--text); font-size: 12px; fill: var(--muted); font-variant-numeric: lining-nums tabular-nums; }
  .rm-bt .name { font-family: var(--text); font-size: 13.5px; fill: var(--ink); }
  .rm-bt .val { font-family: var(--text); font-size: 13.5px; fill: var(--ink); font-variant-numeric: lining-nums tabular-nums; }
  .rm-bt .val.zero { fill: var(--muted); }
  .rm-bt .bar { fill: var(--bar-up); transition: x 0.3s ease, width 0.3s ease; }
  .rm-bt .bar.neg { fill: var(--bar-down); }
  .rm-bt .tick { stroke: var(--ink); stroke-width: 2.6; }
  .rm-key { display: flex; flex-wrap: wrap; align-items: center; gap: 0.1rem 1rem; font-size: 0.92rem; color: var(--ink-soft); font-variant-numeric: lining-nums; margin: 0.45rem 0 0 !important; }
  .rm-key span { display: inline-flex; align-items: center; gap: 0.35rem; white-space: nowrap; }
  .rm-key svg { height: 0.85rem; width: auto; display: inline-block; }
  .rm-controls { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; margin: 0.7rem 0 0.4rem; }
  .rm-bt button { font-family: var(--sc); font-weight: 500; font-size: 1rem; letter-spacing: 0.02em; background: var(--box); color: var(--ink); border: 1.2px solid var(--ink); border-radius: 3px; padding: 0.15rem 0.7rem 0.25rem; cursor: pointer; }
  .rm-bt button:hover { background: var(--hover); }
  .rm-stats { display: flex; flex-wrap: wrap; gap: 0.2rem 1.1rem; font-size: 0.95rem; color: var(--ink-soft); }
  .rm-stats b { color: var(--ink); font-variant-numeric: lining-nums tabular-nums; }
  @media (max-width: 480px) {
    .rm-bt button { font-size: 0.92rem; padding: 0.1rem 0.55rem 0.2rem; }
    .rm-bt .name, .rm-bt .val { font-size: 15px; }
    .rm-bt .axis { font-size: 13.5px; }
  }
</style>

<script>
  const sigma = (z: number) => 1 / (1 + Math.exp(-z));
  // -log sigma(d), written so it doesn't overflow for large |d|
  const nlsig = (d: number) => (d > 0 ? Math.log1p(Math.exp(-d)) : -d + Math.log1p(Math.exp(d)));

  // Ranks with ties sharing their average rank, then the correlation of the ranks.
  function ranks(v: number[]) {
    const idx = v.map((_, i) => i).sort((a, b) => v[a] - v[b]);
    const rk = new Array<number>(v.length).fill(0);
    for (let k = 0; k < idx.length;) {
      let m = k;
      while (m + 1 < idx.length && v[idx[m + 1]] === v[idx[k]]) m++;
      for (let t = k; t <= m; t++) rk[idx[t]] = (k + m) / 2;
      k = m + 1;
    }
    return rk;
  }
  function spearman(a: number[], b: number[]) {
    const ra = ranks(a), rb = ranks(b);
    const ma = ra.reduce((s, x) => s + x, 0) / ra.length, mb = rb.reduce((s, x) => s + x, 0) / rb.length;
    let num = 0, da = 0, db = 0;
    for (let i = 0; i < ra.length; i++) { num += (ra[i] - ma) * (rb[i] - mb); da += (ra[i] - ma) ** 2; db += (rb[i] - mb) ** 2; }
    return da === 0 || db === 0 ? 0 : num / Math.sqrt(da * db);
  }
  const signed = (v: number) => {
    if (Math.abs(v) < 0.005) return '0.00';
    return `${v < 0 ? '−' : '+'}${Math.abs(v).toFixed(2)}`;
  };

  function initRewardModel(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    const Q: number[] = JSON.parse(root.dataset.q || '[]');
    const g = JSON.parse(root.dataset.geom || '{}') as { x0: number; x1: number; lim: number; row: number; top: number };
    const n = Q.length;
    const STEPS = 200, LR = 1;
    const XC = (g.x0 + g.x1) / 2, UNIT = (g.x1 - g.x0) / (2 * g.lim);
    const byQuality = Q.map((_, i) => i).sort((a, b) => Q[b] - Q[a]); // best answer first

    // wins[i][j]: how many times answer i was chosen over answer j
    let wins: number[][] = [];
    let N = 0;
    let r: number[] = [];

    const $ = (sel: string) => root.querySelector(sel) as HTMLElement;
    const rows = Array.from(root.querySelectorAll<SVGGElement>('[data-row]'));

    // The labeler: two different answers at random, then the Bradley-Terry coin.
    function labelOne() {
      const a = Math.floor(Math.random() * n);
      let b = Math.floor(Math.random() * (n - 1));
      if (b >= a) b += 1;
      if (Math.random() < sigma(Q[a] - Q[b])) wins[a][b] += 1; else wins[b][a] += 1;
      N += 1;
    }
    // Mean Bradley-Terry loss of a reward table v over every label so far.
    function loss(v: number[]) {
      let s = 0;
      for (let i = 0; i < n; i++) for (let j = 0; j < n; j++) if (wins[i][j]) s += wins[i][j] * nlsig(v[i] - v[j]);
      return s / N;
    }
    // Gradient descent from zero on the mean loss. Each label pushes the chosen
    // answer up and the rejected one down by sigma(r_rejected - r_chosen), so the
    // table's mean stays 0.
    function train() {
      const v = new Array<number>(n).fill(0);
      if (N === 0) return v;
      for (let t = 0; t < STEPS; t++) {
        const grad = new Array<number>(n).fill(0);
        for (let i = 0; i < n; i++) for (let j = 0; j < n; j++) {
          if (!wins[i][j]) continue;
          const push = wins[i][j] * sigma(v[j] - v[i]);
          grad[i] -= push; grad[j] += push;
        }
        for (let i = 0; i < n; i++) v[i] -= (LR * grad[i]) / N;
      }
      return v;
    }

    function draw() {
      const mean = r.reduce((s, x) => s + x, 0) / n;
      const rc = r.map((x) => x - mean);
      rows.forEach((row, i) => {
        const v = rc[i];
        const cy = g.top + i * g.row + g.row / 2;
        const vv = Math.max(-g.lim, Math.min(g.lim, v));
        const bar = row.querySelector('[data-bar]') as SVGRectElement;
        bar.setAttribute('x', String(XC + Math.min(0, vv) * UNIT));
        bar.setAttribute('width', String(Math.abs(vv) * UNIT));
        bar.classList.toggle('neg', v < 0);
        // past the end of the axis: an arrowhead says the bar keeps going
        const more = row.querySelector('[data-more]') as SVGPathElement;
        const edge = v > 0 ? g.x1 : g.x0, dir = v > 0 ? 1 : -1;
        more.setAttribute('d', Math.abs(v) > g.lim ? `M ${edge} ${cy - 8} L ${edge + dir * 8} ${cy} L ${edge} ${cy + 8} Z` : '');
        more.classList.toggle('neg', v < 0);
        const val = row.querySelector('[data-val]') as SVGTextElement;
        val.textContent = signed(v);
        val.classList.toggle('zero', N === 0);
      });
      $('[data-n]').textContent = String(N);
      if (N === 0) {
        ['[data-loss]', '[data-qloss]', '[data-rank]', '[data-rho]'].forEach((s) => ($(s).textContent = 'none yet'));
        return;
      }
      $('[data-loss]').textContent = loss(r).toFixed(3);
      $('[data-qloss]').textContent = loss(Q).toFixed(3);
      const right = byQuality.every((i, k) => k === 0 || r[byQuality[k - 1]] > r[i]);
      $('[data-rank]').textContent = right ? 'yes' : 'no';
      $('[data-rho]').textContent = spearman(r, Q).toFixed(2);
    }

    function reset() {
      wins = Array.from({ length: n }, () => new Array<number>(n).fill(0));
      N = 0;
      r = new Array<number>(n).fill(0);
      draw();
    }

    root.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((b) => b.addEventListener('click', () => {
      const k = Number(b.dataset.add);
      for (let t = 0; t < k; t++) labelOne();
      r = train();
      draw();
    }));
    $('[data-reset]').addEventListener('click', reset);
    reset();
  }

  function initAll() { document.querySelectorAll<HTMLElement>('[data-rmbt]').forEach(initRewardModel); }
  document.addEventListener('DOMContentLoaded', initAll);
  document.addEventListener('astro:page-load', initAll);
</script>
