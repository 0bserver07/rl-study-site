---
/**
 * ChalkLoop: the RL loop as a small ink figure, with the box that changes per
 * track. Every track is the same loop; what sits on the right (and what comes
 * back) is what differs. Offline RL crosses out the action arrow: no new rollouts.
 * (The name is from the first, chalkboard version of the design.)
 */
interface Props { track: string; label?: string }
const { track, label } = Astro.props;
// Colours are CSS variables (roadmap.css), set as styles so they follow the theme.
const color = `var(--c-${track})`;
const textColor = `var(--c-${track}-text)`; // the same pencil, dark enough to read as text

const VARIANTS: Record<string, { agent: string; box: string[]; out: string; back: string; note: string; noAction?: boolean; loops?: boolean }> = {
  foundations: { agent: 'policy π', box: ['environment'], out: 'action', back: 'state, reward', note: 'The loop itself: an MDP.' },
  classical: { agent: 'policy π', box: ['environment'], out: 'action', back: 'state, reward', note: 'The reward comes from the world.' },
  rlhf: { agent: 'LLM', box: ['reward model'], out: 'response', back: 'score', note: 'The reward model was trained on people picking A over B.' },
  rlaif: { agent: 'LLM', box: ['LLM judge'], out: 'response', back: 'score', note: 'A judge model, or a written constitution, replaces the people.' },
  rlvr: { agent: 'LLM', box: ['checker'], out: 'answer', back: '1 or 0', note: 'A program checks the answer: the tests pass, the math matches.' },
  agentic: { agent: 'LLM', box: ['tools, code,', 'a browser'], out: 'tool call', back: 'result, and later a reward', note: 'Many turns go by before the reward arrives.', loops: true },
  offline: { agent: 'policy', box: ['logged', 'dataset'], out: 'action', back: 'old episodes', note: 'No new rollouts: only what was logged.', noAction: true },
  systems: { agent: 'learner', box: ['rollout', 'workers'], out: 'new weights', back: 'rollouts', note: 'The same loop, spread over many GPUs.' },
};
const v = VARIANTS[track] ?? VARIANTS.foundations;
---

<figure class="bk-loop">
  <svg viewBox="0 0 400 210" role="img" aria-label={`The RL loop for this track: ${v.agent} sends ${v.out} to ${v.box.join(' ')}, which sends back ${v.back}.`} style="width: 100%; height: auto; display: block">
    <defs>
      <marker id={`tip-${track}`} viewBox="0 0 10 10" refX="8.6" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M 1.5 1.5 L 8.6 5 L 1.5 8.5" fill="none" style="stroke: var(--ink-soft)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
      <marker id={`tipc-${track}`} viewBox="0 0 10 10" refX="8.6" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M 1.5 1.5 L 8.6 5 L 1.5 8.5" fill="none" style={`stroke: ${color}`} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
    </defs>
    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <rect x="20" y="78" width="116" height="60" rx="3" style="stroke: var(--ink); fill: var(--box)" stroke-width="1.2" />
      <rect x="262" y="78" width="120" height="60" rx="3" style={`stroke: ${color}; fill: var(--box)`} stroke-width="2" />
      <path d="M 138 92 C 176 50, 224 50, 259 90" style="stroke: var(--ink-soft)" stroke-width="1.2" stroke-dasharray={v.noAction ? '5 5' : undefined} marker-end={`url(#tip-${track})`} />
      <path d="M 260 126 C 224 168, 176 168, 139 126" style={`stroke: ${color}`} stroke-width="1.6" marker-end={`url(#tipc-${track})`} />
      {v.noAction && <path d="M 188 50 L 210 78 M 210 50 L 188 78" style="stroke: var(--red)" stroke-width="2.2" />}
      {v.loops && <path d="M 322 140 C 348 186, 296 198, 304 158" style="stroke: var(--ink-soft)" stroke-width="1.1" marker-end={`url(#tip-${track})`} />}
    </g>
    <g text-anchor="middle" style="font-family: var(--text)">
      <text x="78" y="114" font-size="21" font-style="italic" style="fill: var(--ink)">{v.agent}</text>
      {v.box.length === 1
        ? <text x="322" y="114" font-size={v.box[0].length > 10 ? 17.5 : 20} font-weight="700" style="fill: var(--ink)">{v.box[0]}</text>
        : <><text x="322" y="103" font-size="17.5" font-weight="700" style="fill: var(--ink)">{v.box[0]}</text><text x="322" y="125" font-size="17.5" font-weight="700" style="fill: var(--ink)">{v.box[1]}</text></>}
      <text x="199" y="38" font-size="18" font-style="italic" style="fill: var(--ink-soft)">{v.out}</text>
      <text x="199" y="194" font-size="18" font-style="italic" style={`fill: ${textColor}`}>{v.back}</text>
    </g>
  </svg>
  <figcaption>{label && <b>{label}</b>}{v.note}</figcaption>
</figure>
