---
/**
 * TrackMap: the eight tracks as a prerequisite figure, drawn in ink.
 * Edges come from lecture prerequisites in CURRICULUM.md (scripts/sync-study.mjs):
 * solid when a track's first lecture needs the other track, dashed when only
 * a later lecture does. Each box links to its track on the page.
 */
import study from '../../generated/study.json';

const W = 214, H = 64;
// Hand-placed layout, left to right roughly in reading order.
const POS: Record<string, [number, number]> = {
  foundations: [120, 250],
  classical: [395, 95],
  rlhf: [395, 300],
  systems: [395, 470],
  rlvr: [665, 230],
  rlaif: [665, 410],
  offline: [935, 95],
  agentic: [935, 300],
};
const tracks = study.tracks.filter((t) => POS[t.id]);
const byId = new Map(tracks.map((t) => [t.id, t]));

function trim(a: [number, number], b: [number, number]) {
  const dx = b[0] - a[0], dy = b[1] - a[1];
  const len = Math.hypot(dx, dy) || 1;
  const ux = dx / len, uy = dy / len;
  const t = Math.min((W / 2 + 6) / Math.abs(ux || 1e-9), (H / 2 + 6) / Math.abs(uy || 1e-9));
  return { x1: a[0] + ux * t, y1: a[1] + uy * t, x2: b[0] - ux * t, y2: b[1] - uy * t, ux, uy };
}

const seen = new Set<string>();
const paths = study.trackEdges.flatMap((e, i) => {
  if (!POS[e.from] || !POS[e.to]) return [];
  const pair = [e.from, e.to].sort().join('|');
  if (seen.has(pair)) return [];
  seen.add(pair);
  const back = study.trackEdges.find((o) => o.from === e.to && o.to === e.from);
  const { x1, y1, x2, y2, ux, uy } = trim(POS[e.from], POS[e.to]);
  const bend = (i % 2 ? 1 : -1) * 16;
  const cx = (x1 + x2) / 2 - uy * bend, cy = (y1 + y2) / 2 + ux * bend;
  const why = [...e.because, ...(back ? back.because : [])];
  return [{
    d: `M ${x1.toFixed(1)} ${y1.toFixed(1)} Q ${cx.toFixed(1)} ${cy.toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`,
    kind: e.kind,
    both: Boolean(back),
    title: `${byId.get(e.from)?.name} → ${byId.get(e.to)?.name}${back ? ' (both ways)' : ''}: lecture ${why.join(', ')}`,
  }];
});
---

<div class="bk-map-scroll">
  <svg class="bk-map" viewBox="0 0 1080 540" role="img" aria-labelledby="bk-map-title bk-map-desc">
    <title id="bk-map-title">The track map</title>
    <desc id="bk-map-desc">Eight tracks. Foundations leads to Classical RL and RLHF. RLHF leads to RLVR, RLAIF, and Systems. RLVR leads to Agentic RL and Offline RL. Dashed lines mark single lectures that build on another track.</desc>
    <defs>
      <marker id="bk-arrow" viewBox="0 0 10 10" refX="8.6" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M 1.5 1.5 L 8.6 5 L 1.5 8.5" fill="none" style="stroke: var(--ink-soft)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
    </defs>

    {paths.map((p) => (
      <path class:list={['edge', { dashed: p.kind === 'dashed' }]} d={p.d} marker-end="url(#bk-arrow)" marker-start={p.both ? 'url(#bk-arrow)' : undefined}>
        <title>{p.title}</title>
      </path>
    ))}

    {tracks.map((t, i) => {
      const [x, y] = POS[t.id];
      const hours = Math.round(t.hours);
      return (
        <a class="node" href={`/tracks/${t.id}/`} style={`--c: var(--c-${t.id}); --ct: var(--c-${t.id}-text)`} aria-label={`${t.name}: ${t.lectures.length} lectures, about ${hours} hours`}>
          <rect class="box" x={x - W / 2} y={y - H / 2} width={W} height={H} rx="3" />
          <rect x={x - W / 2} y={y - H / 2} width="6" height={H} style="fill: var(--c)" />
          <text x={x - W / 2 + 22} y={y - 4} font-size="19" font-weight="800" style="fill: var(--ct)">{i + 1}</text>
          <text x={x + 8} y={y - 4} text-anchor="middle" font-size={t.name.length > 14 ? 17 : 18.5} font-weight="700">{t.name}</text>
          <text class="sub" x={x + 8} y={y + 17} text-anchor="middle">{t.lectures.length} lectures, about {hours} hours</text>
        </a>
      );
    })}
  </svg>
</div>
