---
/**
 * LectureFigure: the interactive figure for a lecture, when it has one.
 * The lectures are plain markdown in the study repo, so their figures live here,
 * and PostLayout puts this between "Before you start" and the lecture text.
 * The plan is one figure for each lecture that has an exercise (01, 02, 03, 04,
 * 06, 09, 11, 15, 20): see it move here, then build it in the exercise.
 */
import ValueIteration from './ValueIteration.astro';
import PolicyGradientBandit from './PolicyGradientBandit.astro';
import GridLearner from './GridLearner.astro';
import ActorCriticGrid from './ActorCriticGrid.astro';
import PPOClip from './PPOClip.astro';
import RewardModelBT from './RewardModelBT.astro';
import DPOPolicy from './DPOPolicy.astro';
import GRPOGroup from './GRPOGroup.astro';
import ExplorationChain from './ExplorationChain.astro';

interface Props { lecture?: string }
const { lecture } = Astro.props;

const FIGURES: Record<string, { caption: string }> = {
  '01': {
    caption: 'Value iteration on the same grid as the agent on the home page. Each sweep updates every square once: its value becomes the best, over the four moves, of the reward plus γ times the value of where the move lands. The numbers and shading are those values, and the arrows are the best moves (several when they tie). The values spread out from the +1 one square per sweep. Try γ = 0.5, where the far-away +1 is worth less than the steps it takes to reach it. Then turn on the slippery floor, where a move goes the way you asked 80% of the time and 10% to each side, and pick γ = 0.99: some squares next to a pit now walk into a wall. It wastes a step, but no slip from there lands in the pit. <a href="/exercises/01-mdps/">Exercise 01</a> has you write this.',
  },
  '02': {
    caption: 'REINFORCE on the three slot machines from <a href="/why/">the essay</a>. Each bar is the policy’s chance of pulling that machine. After a pull, its logits move by α(r − b) times the gradient of log π(a), with α = 0.3. With no baseline, b = 0: a pull that pays 0 changes nothing, so the policy learns only from wins. Tick “subtract a baseline” and b is the average reward so far: a below-average pull pushes its machine down. After 100 pulls, a worse machine leads in about one run in seven without it, one in twenty with it. <a href="/exercises/02-policy-gradients/">Exercise 02</a> does this on CartPole, with a network and normalized returns (a baseline plus scaling).',
  },
  '03': {
    caption: 'Q-learning on the same grid, without being told the rewards. The agent finds them by moving, and the shading is its current best guess of each square’s value. Run shows every step; Train 50 episodes skips ahead. <a href="/exercises/03-q-learning/">Exercise 03</a> has you write this.',
  },
  '04': {
    caption: 'Actor-critic on the home page’s grid. Shading is the critic, V(s); arrows are the actor’s most likely moves, darker when more likely. A step’s advantage is the return from that step minus V(s), so the critic is the baseline. The trail is the last episode, green where it beat the critic’s guess and red where it fell short. Green steps push their moves up in the actor, red ones down. Run shows every step; Train 50 episodes skips ahead. By episode 200 most runs reach the goal nearly every time, but about one in twenty is still stuck. <a href="/exercises/04-actor-critic/">Exercise 04</a> has you write this for CartPole, with two networks in place of the tables.',
  },
  '06': {
    caption: 'PPO’s clipped objective for one action in one state, against the probability ratio r&nbsp;=&nbsp;π<sub>new</sub>(a|s)&nbsp;/&nbsp;π<sub>old</sub>(a|s). The ratio starts at 1, because each round of updates begins with the new policy equal to the old one. Drag the dot or use the slider; the dashed line is the unclipped r·A. With A&nbsp;=&nbsp;+1, L goes flat once r passes 1&nbsp;+&nbsp;ε, so making a good action more likely earns nothing more. With A&nbsp;=&nbsp;−1 it goes flat once r drops below 1&nbsp;−&nbsp;ε. On the other side of 1 the min keeps r·A itself, and nowhere is L above r·A. The figure is only this clipped term: <a href="/exercises/05-ppo/">Exercise 05</a> has you write all of PPO on CartPole, with GAE advantages, a value loss and an entropy bonus.',
  },
  '09': {
    caption: 'One prompt, five answers with hidden qualities q, and a simulated labeler who compares two, picked at random. It prefers i over j with probability σ(q<sub>i</sub> − q<sub>j</sub>): the better answer usually wins, but not always. The reward model is a table with one number per answer, and each click retrains it from scratch on every label so far (200 steps of gradient descent on the Bradley-Terry loss). Click Label 10 pairs twice: at 20 labels the ranking is right only about one time in four. By 500 it is nearly always right. <a href="/exercises/09-reward-model/">Exercise 09</a> has you write this loss for a small network that scores feature vectors.',
  },
  '11': {
    caption: 'DPO on one prompt with five answers, A best to E worst by a true reward that training never sees. The data are all 10 pairs, with the better answer always chosen. The policy starts as a copy of the frozen reference, which favours C, and each step is full-batch gradient descent on the mean DPO loss. Press Run: probability flows to A. B wins 3 of its 4 pairs, yet its probability rises and then falls. β scales both the implicit reward and the size of each step, so it changes how fast the policy moves. It doesn’t hold the policy near the reference here: with every pair labelled the same way, longer training moves probability to A at every β. <a href="/exercises/11-dpo/">Exercise 11</a> has you write DPO for 8 prompts with noisy labels.',
  },
  '15': {
    caption: 'GRPO on one question with a checkable answer. The policy starts with 56 at 10%. Each step samples K answers, scores 56 as 1 and the rest 0, gives each the advantage (r − mean) / std within the group, and takes one plain gradient step. Sample a few groups at K = 4: when every answer is wrong, or every one is right, all advantages are 0 and the policy does not move. At K = 4 that is about 40% of the first 20 groups; at K = 16, 5%, but each step samples four times as many answers. <a href="/exercises/15-grpo-rlvr/">Exercise 15</a> has you write this, with Adam, for nine addition questions.',
  },
  '20': {
    caption: 'A 16-square combination lock: right opens the next square, one wrong move (left) ends the episode, the last square pays +1. Both Q-learners use ε = 0.1 and break ties at random. Until its first +1, the top agent’s Q-values stay 0, so it moves at random and its visits pile up near the start: fifteen rights in a row come about once in 33,000 episodes. The bottom one also earns 0.1/√N for reaching a square it has reached N times, so it prefers right wherever it has tried it. One press of Train 50 gets it to the +1 in 99.5% of runs. On this lock any positive bonus would do the same, even a constant one: what a count adds is telling new squares from old ones, which this lock never needs. <a href="/exercises/20-exploration/">Exercise 20</a> has you build the same lock with an RND bonus.',
  },
};
const fig = lecture ? FIGURES[lecture] : undefined;
---

{fig && (
  <section class="bk-box lecture-figure" aria-label="Try it">
    <p class="lf-label">try it</p>
    {lecture === '01' && <ValueIteration caption={fig.caption} />}
    {lecture === '02' && <PolicyGradientBandit caption={fig.caption} />}
    {lecture === '03' && <GridLearner caption={fig.caption} />}
    {lecture === '04' && <ActorCriticGrid caption={fig.caption} />}
    {lecture === '06' && <PPOClip caption={fig.caption} />}
    {lecture === '09' && <RewardModelBT caption={fig.caption} />}
    {lecture === '11' && <DPOPolicy caption={fig.caption} />}
    {lecture === '15' && <GRPOGroup caption={fig.caption} />}
    {lecture === '20' && <ExplorationChain caption={fig.caption} />}
  </section>
)}

<style>
  .lecture-figure { margin: 0 0 2.5rem; }
  .lf-label { font-family: var(--sc); font-weight: 500; color: var(--muted); font-size: 1rem; letter-spacing: 0.02em; margin: 0 0 0.6rem; }
</style>
