---
/**
 * Header (study site): the site's name and a row of small-caps links,
 * like the running head of a book. Inner pages get a "back" line under it.
 */

import { siteConfig } from '../config';

const currentPath = Astro.url.pathname;
const isActive = (url: string) => (url === '/' ? currentPath === '/' : currentPath.startsWith(url));
const items = siteConfig.navigation.items.filter((i) => i.url !== '/');
const isHome = currentPath === '/';
---

<header class="bk-header">
  <div class="bk-header-inner">
    <a href="/" class="bk-site">Study Reinforcement Learning</a>
    <nav class="bk-nav" aria-label="Main">
      {items.map((item) => (
        <a href={item.url} class:list={{ active: isActive(item.url) }}>{item.title.toLowerCase()}</a>
      ))}
      <button type="button" data-open-graph title="All lectures as a graph (G)">graph</button>
      <button type="button" data-open-search title="Search (Ctrl+K)">search<kbd>Ctrl K</kbd></button>
    </nav>
  </div>
</header>

{!isHome && (
  <p class="bk-back"><a href="/">← home</a></p>
)}

<script>
  function initHeader() {
    document.querySelectorAll<HTMLElement>('[data-open-search]').forEach((b) => {
      if (b.dataset.ready) return;
      b.dataset.ready = '1';
      // The command palette opens on Ctrl/Cmd+K.
      b.addEventListener('click', () => {
        document.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', ctrlKey: true, bubbles: true }));
      });
    });
    document.querySelectorAll<HTMLElement>('[data-open-graph]').forEach((b) => {
      if (b.dataset.ready) return;
      b.dataset.ready = '1';
      // The graph modal's own (hidden) button.
      b.addEventListener('click', () => document.getElementById('global-graph-toggle')?.click());
    });
  }
  document.addEventListener('DOMContentLoaded', initHeader);
  document.addEventListener('astro:page-load', initHeader);
</script>
